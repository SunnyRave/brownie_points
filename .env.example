# --- Core ---
AUTH_SECRET=change-me-to-a-long-random-string     # HMAC for signed media URLs + token hashing pepper
APP_URL=http://localhost:3000
# Leave unset to use embedded PGlite (real Postgres in WASM) at .data/pglite
# DATABASE_URL=postgres://app:password@host:5432/azentio
AUTH_METHODS=microsoft,magiclink                   # login screen shows only enabled methods
DEMO_MODE=1                                        # persona quick-login (still uses magic links) + dev mailbox + reset button

# --- Microsoft Entra ID (employees) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
EMPLOYEE_GROUP_ID=                                 # optional (P1)

# --- Optional providers ---
RESEND_API_KEY=                                    # P1 email; without it emails stay "queued"
EMAIL_FROM=portal@azentio.example
ANTHROPIC_API_KEY=                                 # AIRA generation; without it AIRA answers extractively
